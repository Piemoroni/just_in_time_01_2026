generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String

  producoes Producao[]
}

model Produto {
  id         Int     @id @default(autoincrement())
  nome       String
  descricao  String?
  custo      Float
  estoque    Int
  qntdMinimo Int

  producoes Producao[]
}

model Producao {
  id    Int      @id @default(autoincrement())
  qntd  Int
  tipo  String
  dados DateTime @default(now())

  usuarioId Int
  produtoId Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
}